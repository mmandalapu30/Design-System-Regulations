{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/mmandalapu30/Design-System-Regulations/schemas/regulation-schema.json",
  "title": "Design System Regulation",
  "description": "Schema for design system regulation data across platforms and domains.",
  "type": "object",
  "required": ["domain", "version", "lastUpdated", "regulations"],
  "properties": {
    "domain": {
      "type": "string",
      "description": "The platform or domain this regulation set applies to.",
      "enum": ["android", "ios", "health", "automotive"]
    },
    "version": {
      "type": "string",
      "description": "Semantic version of this regulation data.",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "lastUpdated": {
      "type": "string",
      "description": "ISO 8601 date of last update.",
      "format": "date"
    },
    "description": {
      "type": "string",
      "description": "Brief summary of this regulation set."
    },
    "references": {
      "type": "array",
      "description": "External references and standards this regulation set is based on.",
      "items": {
        "type": "object",
        "required": ["name", "url"],
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "description": {
            "type": "string"
          },
          "version": {
            "type": "string",
            "description": "Version or edition of the referenced standard (e.g. 'ISO 15008:2017', '49 CFR § 571.101 as of 2024')."
          }
        }
      }
    },
    "regulations": {
      "type": "array",
      "description": "Array of regulation entries.",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/regulation"
      }
    }
  },
  "definitions": {
    "regulation": {
      "type": "object",
      "required": ["id", "category", "title", "description", "severity", "rules"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for this regulation.",
          "pattern": "^[A-Z]+-\\d{3}$"
        },
        "category": {
          "type": "string",
          "description": "Category of design regulation.",
          "enum": [
            "typography",
            "color",
            "spacing",
            "layout",
            "accessibility",
            "components",
            "navigation",
            "iconography",
            "motion",
            "feedback",
            "compliance",
            "safety",
            "interaction",
            "data-display",
            "privacy"
          ]
        },
        "title": {
          "type": "string",
          "description": "Short human-readable title."
        },
        "description": {
          "type": "string",
          "description": "Detailed description of the regulation."
        },
        "severity": {
          "type": "string",
          "description": "How critical this regulation is.",
          "enum": ["mandatory", "recommended", "optional"]
        },
        "rules": {
          "type": "array",
          "description": "Specific rules within this regulation.",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/rule"
          }
        },
        "tags": {
          "type": "array",
          "description": "Tags for filtering and search.",
          "items": {
            "type": "string"
          }
        },
        "references": {
          "type": "array",
          "description": "Specific references for this regulation.",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "version": {
                "type": "string",
                "description": "Version or edition of the referenced standard."
              }
            }
          }
        }
      }
    },
    "rule": {
      "type": "object",
      "required": ["id", "description", "requirement"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for this rule within its regulation.",
          "pattern": "^[A-Z]+-\\d{3}-\\d{2}$"
        },
        "description": {
          "type": "string",
          "description": "What this rule requires."
        },
        "requirement": {
          "type": "string",
          "description": "The specific technical requirement."
        },
        "value": {
          "description": "Concrete value for the rule (e.g., minimum size, color code)."
        },
        "unit": {
          "type": "string",
          "description": "Unit of measurement for the value."
        },
        "rationale": {
          "type": "string",
          "description": "Reasoning behind this rule."
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "description": "The exact URL of the document, page, or section this rule is sourced from."
        },
        "images": {
          "type": "array",
          "description": "Visual references (diagrams, illustrations) associated with this rule. Only include verified, publicly accessible image URLs.",
          "items": {
            "type": "object",
            "required": ["url", "alt"],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri",
                "description": "Direct URL to the image."
              },
              "alt": {
                "type": "string",
                "description": "Accessible alternative text describing the image."
              },
              "caption": {
                "type": "string",
                "description": "Optional caption or figure reference (e.g. 'Figure 3-1, DOT HS 812 483, p.18')."
              }
            }
          }
        }
      }
    }
  }
}
